    {
      "number": "01",
      "name": "Sequence to Sequence Learning",
      "area": "NLP",
      "status": "Completed",
      "statusKey": "done",
      "folderUrl": "https://github.com/Fasmanuel2002/Paper-Reimplementations/tree/main/01_Sequence_to_Sequence_Learning",
      "papers": [
        {
          "title": "Sequence to Sequence Learning with Neural Networks",
          "authors": [
            "Ilya Sutskever",
            "Oriol Vinyals",
            "Quoc V. Le"
          ],
          "year": 2014,
          "arxivId": "1409.3215",
          "url": "https://arxiv.org/abs/1409.3215"
        },
        {
          "title": "Neural Machine Translation by Jointly Learning to Align and Translate",
          "authors": [
            "Dzmitry Bahdanau",
            "Kyunghyun Cho",
            "Yoshua Bengio"
          ],
          "year": 2014,
          "arxivId": "1409.0473",
          "url": "https://arxiv.org/abs/1409.0473"
        }
      ],
      "implementation": "PyTorch LSTM encoder-decoder baseline (weights initialized uniformly between -0.08 and 0.08, following the Seq2Seq paper) and a bidirectional-GRU encoder with additive (Bahdanau) attention, compared with BLEU and ROUGE.",
      "note": null,
      "dataset": "Synthetic dataset of 10,000 generated examples (create_dataset.py) that map natural-language reminders to structured task lists; the folder README says a synthetic dataset was used because no GPU was available.",
      "results": [
        {
          "metric": "BLEU",
          "values": [
            "~0.84",
            "~0.91"
          ]
        },
        {
          "metric": "ROUGE-1",
          "values": [
            "~0.876",
            "~0.944"
          ]
        },
        {
          "metric": "ROUGE-2",
          "values": [
            "~0.845",
            "~0.937"
          ]
        },
        {
          "metric": "ROUGE-L",
          "values": [
            "~0.876",
            "~0.943"
          ]
        }
      ],
      "resultColumns": [
        "Baseline Seq2Seq",
        "Seq2Seq with attention"
      ],
      "caveat": "The code (models/seq2seq_baseline.py, models/seq2seq_attention.py) implements the core model of each paper. Results come from a synthetic dataset rather than the papers' machine-translation benchmarks, so they are not comparable with published numbers.",
      "figure": null
    },
    {
      "number": "02",
      "name": "Attention Is All You Need",
      "area": "Transformers / NLP",
      "status": "Completed",
      "statusKey": "done",
      "folderUrl": "https://github.com/Fasmanuel2002/Paper-Reimplementations/tree/main/02_Attention_Is_All_You_Need",
      "papers": [
        {
          "title": "Attention Is All You Need",
          "authors": [
            "Ashish Vaswani",
            "Noam Shazeer",
            "Niki Parmar",
            "Jakob Uszkoreit",
            "Llion Jones",
            "Aidan N. Gomez",
            "Lukasz Kaiser",
            "Illia Polosukhin"
          ],
          "year": 2017,
          "arxivId": "1706.03762",
          "url": "https://arxiv.org/abs/1706.03762"
        }
      ],
      "implementation": "Decoder-only, GPT-style Transformer language model (about 11 million parameters) with token and positional embeddings, causal masked multi-head self-attention, feed-forward layers, layer normalization and residual connections, trained for next-token prediction on a dataset of William Shakespeare's works on an NVIDIA L4 GPU, following Andrej Karpathy's 'Let's build GPT: from scratch' tutorial.",
      "note": null,
      "dataset": null,
      "results": [],
      "resultColumns": [
        "Value"
      ],
      "caveat": null,
      "figure": {
        "src": "/images/figures/gpt-decoder-only.webp",
        "width": 800,
        "height": 1126,
        "orientation": "portrait",
        "alt": "Decoder-only Transformer diagram: input and output embeddings with positional encoding feed N stacked blocks of masked multi-head attention and feed-forward layers with add and norm, followed by a linear layer and softmax over output probabilities.",
        "caption": "Decoder-only Transformer architecture used for the GPT-style model.",
        "credit": "Adapted from Figure 1 of Vaswani et al. (2017), \"Attention Is All You Need\", arXiv:1706.03762."
      }
    },
    {
      "number": "03",
