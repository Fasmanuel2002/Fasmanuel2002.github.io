    {
      "number": "04",
      "name": "An Image Is Worth 16×16 Words",
      "area": "Computer Vision / Transformers",
      "status": "Completed",
      "statusKey": "done",
      "folderUrl": "https://github.com/Fasmanuel2002/Paper-Reimplementations/tree/main/04_An_Image_Is_Worth_16x16_Words",
      "papers": [
        {
          "title": "An Image is Worth 16x16 Words: Transformers for Image Recognition at Scale",
          "authors": [
            "Alexey Dosovitskiy",
            "Lucas Beyer",
            "Alexander Kolesnikov",
            "Dirk Weissenborn",
            "Xiaohua Zhai",
            "Thomas Unterthiner",
            "Mostafa Dehghani",
            "Matthias Minderer",
            "Georg Heigold",
            "Sylvain Gelly",
            "Jakob Uszkoreit",
            "Neil Houlsby"
          ],
          "year": 2020,
          "arxivId": "2010.11929",
          "url": "https://arxiv.org/abs/2010.11929"
        }
      ],
      "implementation": "Encoder-only Vision Transformer in PyTorch: 16x16 patch embedding (224x224 images into 196 patches), learnable [CLS] token and position embeddings, pre-norm encoder blocks with multi-head self-attention and a GELU MLP; 12 layers, hidden size 384, MLP size 1536, 6 attention heads, about 21.5 million parameters; trained on an NVIDIA L4 GPU.",
      "note": null,
      "dataset": "Trained from scratch on Imagenette2 (10 classes), then partially fine-tuned (last two Transformer blocks, final layer normalization and a new head; 3.75M of 21.5M parameters trainable) on a 525-class bird species dataset.",
      "results": [
        {
          "metric": "Test accuracy on Imagenette2 (100 test images)",
          "values": [
            "66.00%"
          ]
        },
        {
          "metric": "Validation accuracy after partial fine-tuning on 525 bird species",
          "values": [
            "39.07%"
          ]
        }
      ],
      "resultColumns": [
        "Value"
      ],
      "caveat": "The code (model/ViT.py) implements the ViT method: patch embedding, [CLS] token, position embeddings and a Transformer encoder. The model is trained at small scale from scratch, so accuracy is not comparable with the paper's results.",
      "figure": {
        "src": "/images/figures/vit-overview.webp",
        "width": 720,
        "height": 531,
        "orientation": "landscape",
        "alt": "Vision Transformer overview: an image is split into fixed-size patches, each patch is linearly projected and combined with a position embedding plus an extra learnable class embedding, passed through a Transformer encoder, and classified by an MLP head.",
        "caption": "Vision Transformer (ViT) model overview.",
        "credit": "Figure 1 of Dosovitskiy et al. (2020), \"An Image is Worth 16x16 Words\", arXiv:2010.11929 (the repository README marks it as taken from the original paper)."
      }
    },
